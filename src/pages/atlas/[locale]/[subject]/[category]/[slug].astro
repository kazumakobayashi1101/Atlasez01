<script>
  // 匿名の利用統計。個人情報や端末識別子を送らず、記事ごとの日別集計だけを残す。
  const analyticsActions = document.querySelector<HTMLElement>("[data-article-actions]");
  const analyticsArticleBody = document.querySelector<HTMLElement>(".article-body");
  if (analyticsActions && analyticsArticleBody) {
    const data = analyticsActions.dataset;
    const analyticsPayload = {
      articleId: data.articleId ?? "",
      articleTitle: data.title ?? "",
      subject: data.subjectSlug ?? "",
      category: data.categorySlug ?? "",
      locale: data.locale ?? "ja",
    };
    const sent = new Set<string>();
    const endpoint = window.location.hostname === "mitukx.github.io"
      ? "https://atlasez-web-1.ukyoukay0.workers.dev/api/article-analytics"
      : "/api/article-analytics";
    const track = (event: "view" | "engaged" | "complete") => {
      if (sent.has(event)) return;
      sent.add(event);
      void fetch(endpoint, {
        method: "POST",
        keepalive: true,
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ ...analyticsPayload, event }),
      }).catch(() => {
        // 統計送信の失敗は記事閲覧を妨げない。
      });
    };
    track("view");
    window.setTimeout(() => {
      if (document.visibilityState === "visible") track("engaged");
    }, 15_000);
    const checkCompletion = () => {
      const threshold = analyticsArticleBody.offsetTop + analyticsArticleBody.offsetHeight * 0.9;
      if (window.scrollY + window.innerHeight >= threshold) track("complete");
    };
    window.addEventListener("scroll", checkCompletion, { passive: true });
    window.addEventListener("resize", checkCompletion);
    checkCompletion();
  }
</script>

<script>
  // 数学以外の記事でも、[[ref:記事タイトル]] と旧形式の
  // [記事タイトル:定義 1] を公開状況に応じてリンク化する。
  // 数学記事は上の数式処理内で同じ変換を行うため、ここでは対象外にする。
  const referenceBody = document.querySelector<HTMLElement>(".article-body");
  const referenceMeta = document.querySelector<HTMLElement>("[data-article-actions]");
  if (referenceBody && referenceMeta?.dataset.subjectSlug !== "mathematics") {
    const referenceMap = (() => {
      try {
        const parsed = JSON.parse(referenceBody.dataset.articleReferenceMap ?? "{}");
        return parsed && typeof parsed === "object"
          ? parsed as Record<string, string>
          : {};
      } catch {
        return {};
      }
    })();
    const referencePattern = /\[\[ref:([^\]\n]+)\]\]|\[([^\]\n]+)\]/gu;
    const walker = document.createTreeWalker(referenceBody, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    let current = walker.nextNode();
    while (current) {
      textNodes.push(current as Text);
      current = walker.nextNode();
    }
    textNodes.forEach((node) => {
      const parent = node.parentElement;
      if (!parent || parent.closest("a,code,pre,script,style")) return;
      const value = node.nodeValue ?? "";
      let changed = false;
      let cursor = 0;
      const fragment = document.createDocumentFragment();
      referencePattern.lastIndex = 0;
      let match: RegExpExecArray | null;
      while ((match = referencePattern.exec(value))) {
        const referenceId = match[1]?.trim() ?? "";
        const reference = match[2]?.trim() ?? "";
        const rawReference = referenceId || reference;
        const legacyParts = reference.match(
          /^(.+?)\s*:\s*(?:定義|命題|定理|補題|系|例)\s*\d+\s*$/u,
        );
        const title = referenceId || legacyParts?.[1]?.trim() || "";
        if (!title) continue;
        fragment.append(value.slice(cursor, match.index));
        const href = referenceId ? referenceMap[referenceId] : referenceMap[reference];
        if (href) {
          const link = document.createElement("a");
          link.className = "article-reference";
          link.href = referenceId ? href : `${href}#math-block-${reference.match(/(\d+)\s*$/u)?.[1] ?? ""}`;
          link.dataset.articleReference = rawReference;
          link.textContent = rawReference;
          fragment.append(link);
        } else {
          const pending = document.createElement("span");
          pending.className = "article-reference article-reference-pending";
          pending.dataset.articleReference = rawReference;
          pending.title = "参照先の記事が公開されるとリンクになります";
          pending.textContent = rawReference;
          fragment.append(pending);
        }
        cursor = match.index + match[0].length;
        changed = true;
      }
      if (!changed) return;
      fragment.append(value.slice(cursor));
      node.parentNode?.replaceChild(fragment, node);
    });
  }
</script>

<script>
  // 記事本文のどこまで来たかを画面上端の帯で示す
  const progressBar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const articleBody = document.querySelector<HTMLElement>(".article-body");

  if (progressBar && articleBody) {
    const update = () => {
      const rect = articleBody.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      // 本文が画面より短い記事では帯を出しても意味がないので 0 のままにする
      const ratio = total <= 0 ? 0 : (-rect.top / total) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, ratio))}%`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  // 現在読んでいる見出しを目次で強調する（scroll-spy）
  const links = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    .forEach((a) => {
      const id = a.dataset.tocLink;
      if (id) links.set(id, a);
    });
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if ("IntersectionObserver" in window && headings.length > 0) {
    let currentId: string | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            currentId = e.target.id;
          }
        }
        if (currentId) {
          links.forEach((a, id) => {
            if (id === currentId) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    headings.forEach((h) => observer.observe(h));
  }

  // モバイルでは目次を初期状態で閉じる
  const mq = window.matchMedia("(max-width: 1023px)");
  const details = document.querySelector<HTMLDetailsElement>(".toc-details");
  const mobileTocTrigger = document.querySelector<HTMLButtonElement>("[data-mobile-toc]");
  const syncMobileTocState = () => {
    mobileTocTrigger?.setAttribute("aria-expanded", String(details?.open ?? false));
  };
  if (details && mq.matches) details.open = false;
  syncMobileTocState();
  details?.addEventListener("toggle", syncMobileTocState);
  details?.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", () => {
      if (mq.matches) {
        details.open = false;
        syncMobileTocState();
      }
    });
  });
  mobileTocTrigger?.addEventListener("click", () => {
    if (!details) return;
    details.open = !details.open;
    syncMobileTocState();
    if (details.open) {
      window.setTimeout(() => details.querySelector<HTMLAnchorElement>("a")?.focus(), 120);
    }
  });
</script>

<script>
  const reportForm = document.querySelector<HTMLFormElement>("[data-issue-report-form]");
  if (reportForm) {
    reportForm.dataset.openedAt = String(Date.now());
    const status = reportForm.querySelector<HTMLElement>("[data-issue-report-status]");
    const submit = reportForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const isJapanese = reportForm.dataset.locale === "ja";
    reportForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!reportForm.reportValidity()) return;

      const values = new FormData(reportForm);
      const setStatus = (message: string, state: "success" | "error" | "sending") => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };
      submit?.setAttribute("disabled", "");
      setStatus(isJapanese ? "送信しています…" : "Sending…", "sending");
      try {
        const reportEndpoint = window.location.hostname === "mitukx.github.io"
          ? "https://atlasez-web-1.ukyoukay0.workers.dev/api/article-reports"
          : "/api/article-reports";
        const response = await fetch(reportEndpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            articleTitle: reportForm.dataset.articleTitle,
            articleUrl: window.location.href,
            articleId: reportForm.dataset.articleId,
            subject: reportForm.dataset.articleSubject,
            category: reportForm.dataset.articleCategory,
            locale: reportForm.dataset.locale,
            openedAt: reportForm.dataset.openedAt,
            reportType: values.get("reportType"),
            details: values.get("details"),
            contact: values.get("contact"),
            website: values.get("website"),
          }),
        });
        const contentType = response.headers.get("content-type") ?? "";
        const result = contentType.includes("application/json")
          ? (await response.json()) as { ok?: boolean; error?: string }
          : undefined;
        if (!response.ok || !result?.ok) {
          throw new Error(result?.error ?? (isJapanese
            ? "送信先に接続できませんでした。時間をおいて再度お試しください。"
            : "The report endpoint is unavailable. Please try again later."));
        }
        reportForm.reset();
        setStatus(isJapanese ? "送信しました。ご協力ありがとうございます。" : "Report sent. Thank you.", "success");
      } catch (error) {
        const message = error instanceof Error && error.message
          ? error.message
          : isJapanese ? "送信できませんでした。時間をおいて再度お試しください。" : "Could not send the report. Please try again later.";
        setStatus(message, "error");
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  }
</script>

<script>
  const articleActionRoot = document.querySelector<HTMLElement>("[data-article-actions]");
  const articleShareButton = articleActionRoot?.querySelector<HTMLButtonElement>("[data-article-share]");
  const articleCopyButton = articleActionRoot?.querySelector<HTMLButtonElement>("[data-article-copy]");
  const articleActionStatus = articleActionRoot?.querySelector<HTMLElement>("[data-article-action-status]");
  if (articleActionRoot && (articleShareButton || articleCopyButton)) {
    const articleData = articleActionRoot.dataset;
    const articleUrl = new URL(articleData.href ?? window.location.pathname, window.location.origin).href;
    const isJapanese = articleData.locale === "ja";
    const copiedMessage = articleData.labelCopied ?? (isJapanese ? "リンクをコピーしました" : "Link copied");
    const shareFailedMessage = articleData.labelShareFailed ?? (isJapanese ? "共有できませんでした。" : "Could not share.");

    const showActionStatus = (message: string) => {
      if (!articleActionStatus) return;
      articleActionStatus.textContent = message;
      window.setTimeout(() => {
        if (articleActionStatus.textContent === message) articleActionStatus.textContent = "";
      }, 2400);
    };

    const copyArticleLink = async (): Promise<void> => {
      try {
        await navigator.clipboard.writeText(articleUrl);
        showActionStatus(copiedMessage);
      } catch {
        showActionStatus(shareFailedMessage);
      }
    };

    articleCopyButton?.addEventListener("click", () => {
      void copyArticleLink();
    });
    articleShareButton?.addEventListener("click", async () => {
      if (typeof navigator.share !== "function") {
        await copyArticleLink();
        return;
      }
      try {
        await navigator.share({ title: articleData.title ?? "Atlasez", url: articleUrl });
      } catch (error) {
        if (!(error instanceof DOMException) || error.name !== "AbortError") {
          showActionStatus(shareFailedMessage);
        }
      }
    });
  }
</script>

<script>
  // 「あとで読む」と「読んだ・理解した」の状態反映とトグル
  import { toggleBookmark, isBookmarked } from "../../../../../lib/bookmarks";
  import {
    historyStateOf,
    setHistoryState,
    HISTORY_STAGES,
    type HistoryState,
  } from "../../../../../lib/history";

  const actions = document.querySelector<HTMLElement>("[data-article-actions]");
  if (actions) {
    const d = actions.dataset;
    const articleId = d.articleId ?? "";
    // 3つのボタンで同じ記事情報を使う
    const entry = {
      articleId,
      locale: d.locale ?? "",
      title: d.title ?? "",
      href: d.href ?? "",
      subject: d.subject ?? "",
      category: d.category ?? "",
      summary: d.summary ?? "",
    };

    const bookmarkBtn = actions.querySelector<HTMLButtonElement>(
      "[data-bookmark-toggle]",
    );
    if (bookmarkBtn) {
      const bd = bookmarkBtn.dataset;
      const labelEl =
        bookmarkBtn.querySelector<HTMLElement>("[data-bookmark-label]");
      const iconEl =
        bookmarkBtn.querySelector<HTMLElement>("[data-bookmark-icon]");

      const renderBookmark = (on: boolean) => {
        bookmarkBtn.setAttribute("aria-pressed", on ? "true" : "false");
        if (labelEl) {
          labelEl.textContent = on ? (bd.labelSaved ?? "") : (bd.labelSave ?? "");
        }
        if (iconEl) iconEl.textContent = on ? "★" : "☆";
      };

      renderBookmark(isBookmarked(articleId));
      bookmarkBtn.addEventListener("click", () => {
        renderBookmark(toggleBookmark(entry));
      });
    }

    const historyToggles = [
      ...document.querySelectorAll<HTMLButtonElement>(
        "[data-history-stage-toggle]",
      ),
    ];
    const historyControls = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-history-stage-control]",
      ),
    ];
    const states: Array<HistoryState | null> = [
      null,
      ...HISTORY_STAGES.map((stage) => stage.id),
    ];
    const stateLabels = [
      historyToggles[0]?.dataset.labelNone ?? "",
      historyToggles[0]?.dataset.labelRead ?? "",
      historyToggles[0]?.dataset.labelUnderstood ?? "",
    ];
    const renderHistory = (state: HistoryState | null) => {
      const index = states.indexOf(state);
      historyToggles.forEach((toggle) => {
        toggle.dataset.state = state ?? "none";
        toggle.setAttribute("aria-valuenow", String(index));
        toggle.setAttribute("aria-valuetext", stateLabels[index] ?? "");
      });
      historyControls.forEach((control) => {
        control.dataset.state = state ?? "none";
      });
    };

    let currentState = historyStateOf(articleId);
    renderHistory(currentState);
    const moveTo = (index: number) => {
      const bounded = Math.max(0, Math.min(states.length - 1, index));
      currentState = setHistoryState(entry, states[bounded]);
      renderHistory(currentState);
    };
    historyToggles.forEach((historyToggle) => {
      historyToggle.addEventListener("click", (event) => {
        // ポインター操作では、触れた位置に最も近い段階へレバーを移す。
        // キーボードによる click は座標を持たないため、従来どおり1段進める。
        if (event.detail === 0) {
          const currentIndex = states.indexOf(currentState);
          moveTo((currentIndex + 1) % states.length);
          return;
        }
        const rect = historyToggle.getBoundingClientRect();
        const ratio = Math.max(
          0,
          Math.min(1, (event.clientX - rect.left) / rect.width),
        );
        moveTo(Math.round(ratio * (states.length - 1)));
      });
      historyToggle.addEventListener("keydown", (event) => {
        const currentIndex = states.indexOf(currentState);
        if (event.key === "ArrowRight" || event.key === "ArrowUp") {
          event.preventDefault();
          moveTo(currentIndex + 1);
        } else if (event.key === "ArrowLeft" || event.key === "ArrowDown") {
          event.preventDefault();
          moveTo(currentIndex - 1);
        } else if (event.key === "Home") {
          event.preventDefault();
          moveTo(0);
        } else if (event.key === "End") {
          event.preventDefault();
          moveTo(states.length - 1);
        }
      });
    });

    // 数学記事のPandoc風マークアップを、読みやすいカードと折りたたみ証明へ整える。
    // 明示的な .defi/.prop 等はそのまま尊重し、プレーンMarkdownの見出しも対象にする。
    const mathBody = document.querySelector<HTMLElement>(".article-body");
    const articleMeta = document.querySelector<HTMLElement>("[data-article-actions]");
    if (mathBody && articleMeta?.dataset.subjectSlug === "mathematics") {
      const labelToClass: Record<string, string> = { "定義": "defi", "命題": "prop", "定理": "thm", "補題": "lemma", "系": "cor", "例": "example" };
      const theoremLead = /^(定義|命題|定理|補題|系|例)\s*(?:\d+|[（(:：．。\.])/u;
      const proofLead = /^証明(?:\s|[．。\.:：]|$)/u;
      const isTheoremLead = (node: Element) => node.tagName === "P" && theoremLead.test((node.textContent ?? "").trim());
      const isProofLead = (node: Element) => node.tagName === "P" && proofLead.test((node.textContent ?? "").trim());
      const isHeading = (node: Element) => ["H2", "H3"].includes(node.tagName);
      const isDisplayMath = (node: Element) => node.matches(".katex-display,mjx-container[display=\"true\"]");
      const isMathBlock = (node: Element) => node.matches(
        ".defi,.prop,.thm,.lemma,.cor,.example,.math-definition,.math-theorem,.proof,.proof-details,.folding,.supp,.supp-details",
      );
      // 新しい原稿の証明境界は :::proof がビルド時に details へ変換する。
      // ブラウザでは、旧HTMLが明示した .proof だけを後方互換で扱い、
      // 「証明.」という文面から終端を推測しない。
      const isProofNode = (node: Element) => node.matches(".proof");
      // 証明は「◻」「□」「∎」で閉じる。証明の後に続く本文まで枠へ
      // 取り込まないよう、終止記号を見つけた時点で取り込みを打ち切る。
      const qedLead = /[◻□∎]\s*$/u;
      const closesProof = (node: Element) => qedLead.test((node.textContent ?? "").trim());
      // MathJax が本文末尾へ挿入する style などは枠の中身にしない。
      const isRenderableBlock = (node: Element) =>
        !["STYLE", "SCRIPT", "LINK", "TEMPLATE", "META"].includes(node.tagName);
      const legacyDetails = (node: HTMLElement) => {
        const isSupplement = node.classList.contains("supp");
        const details = document.createElement("details");
        details.className = isSupplement ? "supp-details" : "folding";
        const explicitSummary = node.dataset.summary || node.dataset.title;
        const first = node.firstElementChild;
        let summary: HTMLElement;
        if (first?.tagName === "SUMMARY") {
          summary = first as HTMLElement;
          first.remove();
        } else {
          summary = document.createElement("summary");
          summary.className = isSupplement ? "supp-details-summary" : "folding-summary";
          const title = explicitSummary
            || (first?.matches(".folding-title,.supp-title,h4") ? first.textContent?.trim() : "")
            || (isSupplement ? "補足." : "折りたたみ");
          summary.textContent = title;
          if (first?.matches(".folding-title,.supp-title,h4")) first.remove();
        }
        const inner = document.createElement("div");
        inner.className = isSupplement ? "supp-details-inner" : "folding-content";
        while (node.firstChild) inner.append(node.firstChild);
        details.append(summary, inner);
        node.replaceWith(details);
        return details;
      };
      // 旧 Pandoc 原稿では折りたたみが div.folding / div.supp として
      // 保存されていた。CSS だけでは div の中身は開閉できず、変換時に
      // 取りこぼされることがあるため、本文を移動して details に昇格する。
      [...mathBody.querySelectorAll<HTMLElement>("div.folding,div.supp")].forEach((node) => {
        if (node.closest("details.folding,details.supp-details")) return;
        legacyDetails(node);
      });
      const normalizeTheoremLabel = (value: string) => {
        const trimmed = value.trim().replace(/[.．。:：]+$/u, "");
        return trimmed ? `${trimmed}.` : trimmed;
      };
      const theoremLabelPrefix = /^(\s*(?:定義|命題|定理|補題|系|例)\s*(?:\d+\s*)?)/u;
      const pairedDelimiter = new Map([
        ["(", ")"],
        ["（", "）"],
      ]);
      const readTheoremLabel = (value: string) => {
        const prefix = value.match(theoremLabelPrefix);
        if (!prefix) return null;
        let end = prefix[0].length;
        let sawTitle = false;
        while (end < value.length && /\s/u.test(value[end] ?? "")) end += 1;
        while (end < value.length) {
          const opening = value[end] ?? "";
          const closing = pairedDelimiter.get(opening);
          if (!closing) break;
          sawTitle = true;
          const stack = [closing];
          end += 1;
          while (end < value.length && stack.length > 0) {
            const char = value[end] ?? "";
            const nestedClosing = pairedDelimiter.get(char);
            if (nestedClosing) stack.push(nestedClosing);
            else if (char === stack[stack.length - 1]) stack.pop();
            end += 1;
          }
          if (stack.length > 0) return null;
          while (end < value.length && /\s/u.test(value[end] ?? "")) end += 1;
        }
        if (/[.．。:：]/u.test(value[end] ?? "")) {
          end += 1;
        } else if (!sawTitle) {
          return null;
        }
        while (end < value.length && /\s/u.test(value[end] ?? "")) end += 1;
        return { label: value.slice(0, end), rest: value.slice(end) };
      };
      const addTheoremLabel = (wrapper: HTMLElement) => {
        const paragraph = wrapper.querySelector<HTMLElement>(":scope > p");
        if (!paragraph || paragraph.querySelector(":scope > .thmtitle")) return;
        const firstElement = paragraph.firstElementChild;
        if (firstElement?.matches("strong,b")) {
          const label = firstElement.textContent?.trim() ?? "";
          if (/^(定義|命題|定理|補題|系|例)/u.test(label)) {
            const title = document.createElement("span");
            title.className = "thmtitle";
            title.textContent = normalizeTheoremLabel(label);
            firstElement.replaceWith(title);
            return;
          }
        }
        const firstText = [...paragraph.childNodes].find((child) => child.nodeType === Node.TEXT_NODE && (child.textContent ?? "").trim());
        if (!firstText) return;
        const parsedLabel = readTheoremLabel(firstText.textContent ?? "");
        if (!parsedLabel) return;
        const title = document.createElement("span");
        title.className = "thmtitle";
        title.textContent = normalizeTheoremLabel(parsedLabel.label);
        firstText.parentNode?.insertBefore(title, firstText);
        firstText.textContent = parsedLabel.rest;
      };
      const topLevel = () => [...mathBody.children] as HTMLElement[];
      for (const node of topLevel()) {
        if (node.tagName !== "P" || node.closest(".defi,.prop,.thm,.lemma,.cor,.example,.proof-details")) continue;
        const text = (node.textContent ?? "").trim();
        const match = Object.keys(labelToClass).find((label) => text.startsWith(label) && theoremLead.test(text));
        if (!match) continue;
        const wrapper = document.createElement("div");
        wrapper.className = labelToClass[match] ?? "math-theorem";
        node.replaceWith(wrapper);
        wrapper.append(node);
        addTheoremLabel(wrapper);
        let next = wrapper.nextElementSibling;
        let sawDisplayMath = false;
        while (next) {
          if (!isRenderableBlock(next)) break;
          if (isHeading(next) || isMathBlock(next) || isTheoremLead(next) || isProofLead(next)) break;
          if (isDisplayMath(next)) {
            const following = next.nextElementSibling;
            wrapper.append(next);
            next = following;
            sawDisplayMath = true;
            continue;
          }
          if (next.tagName === "OL" || next.tagName === "UL") {
            const following = next.nextElementSibling;
            wrapper.append(next);
            next = following;
            continue;
          }
          // remark-math places display equations between paragraphs. Keep the
          // entire contiguous run in the same card until the next theorem,
          // heading, proof, or other math block. This matters for examples
          // such as group examples 5 and 7, which contain multiple equations.
          if (sawDisplayMath && next.tagName === "P") {
            const following = next.nextElementSibling;
            wrapper.append(next);
            next = following;
            continue;
          }
          break;
        }
      }

      // Directiveで生成された枠はすでに `.defi` などの要素になっているため、
      // 上の旧形式向け処理ではラベルが追加されない。公開ページでも管理画面と
      // 同じ通し番号（定義1、命題2…）を付け、タイトルがある場合だけ括弧内へ
      // 残す。本文が空になった場合でも番号だけは失われないよう、DOMから再計算する。
      const statementLabel = (wrapper: HTMLElement) => {
        const byDirective: Record<string, string> = {
          defi: "定義", definition: "定義", prop: "命題", proposition: "命題",
          thm: "定理", theorem: "定理", lemma: "補題", cor: "系", corollary: "系",
          example: "例",
        };
        const directive = wrapper.dataset.directive?.toLowerCase();
        if (directive && byDirective[directive]) return byDirective[directive];
        return Object.keys(labelToClass).find((label) =>
          wrapper.classList.contains(labelToClass[label]),
        ) ?? null;
      };
      const statements = [...mathBody.children].filter((node): node is HTMLElement =>
        node instanceof HTMLElement && node.matches(".defi,.prop,.thm,.lemma,.cor,.example"),
      );
      let statementNumber = 0;
      for (const wrapper of statements) {
        const label = statementLabel(wrapper);
        if (!label) continue;
        const title = wrapper.querySelector<HTMLElement>(":scope > p > .thmtitle, :scope > .thmtitle");
        if (!title) continue;
        // The published HTML already contains MathJax SVG for inline math in
        // directive titles. Do not replace it with textContent while adding
        // the article-wide statement number; that turns `$ab$` back into
        // literal source in the browser even though the server render is
        // correct. The marker makes this safe if Astro page-load runs twice.
        if (title.dataset.statementNumbered === "true") {
          statementNumber += 1;
          wrapper.dataset.statementNumber = String(statementNumber);
          wrapper.dataset.statementLabel = label;
          continue;
        }
        const source = title.dataset.authoredStatementTitle ?? title.textContent?.trim() ?? "";
        const hasAuthoredNumber = new RegExp(`^${label}\\s*\\d+\\b`, "u").test(source);
        const authored = source
          .replace(new RegExp(`^${label}\\s*\\d*\\s*[.．。:：]?\\s*`, "u"), "")
          .replace(/^[（(]\\s*(.*?)\\s*[）)]$/u, "$1")
          .replace(/[.．。:：]\\s*$/u, "")
          .trim();
        title.dataset.authoredStatementTitle = source;
        statementNumber += 1;
        // Older articles already contain a carefully formatted numbered label;
        // preserve it verbatim. New directive titles receive the missing
        // Japanese label and article-wide number.
        const normalizedSource = source.replace(
          new RegExp(`^${label}\\s*(\\d+)`, "u"),
          `${label} $1`,
        );
        if (hasAuthoredNumber) {
          // Keep any server-rendered MathJax nodes. Numbered legacy titles
          // are already complete and only need their metadata refreshed.
          if (normalizedSource !== source && !title.querySelector("mjx-container")) {
            title.textContent = normalizedSource;
          }
        } else if (title.querySelector("mjx-container")) {
          const renderedTitle = [...title.childNodes].map((node) => node.cloneNode(true));
          title.replaceChildren(
            document.createTextNode(`${label} ${statementNumber}${authored ? " (" : ""}`),
            ...renderedTitle,
            ...(authored ? [document.createTextNode(")")] : []),
          );
        } else {
          title.textContent = `${label} ${statementNumber}${authored ? ` (${authored})` : ""}`;
        }
        title.dataset.statementNumbered = "true";
        wrapper.dataset.statementNumber = String(statementNumber);
        wrapper.dataset.statementLabel = label;
      }

      const theoremCards = [...mathBody.children].filter((node): node is HTMLElement =>
        node instanceof HTMLElement && node.matches(".defi,.prop,.thm,.lemma,.cor,.example,.math-definition,.math-theorem"),
      );

      const removeProofLabel = (container: Element) => {
        const strong = container.querySelector(":scope > strong");
        if (strong && proofLead.test((strong.textContent ?? "").trim())) {
          strong.remove();
          return;
        }
        const firstText = [...container.childNodes].find((child) => child.nodeType === Node.TEXT_NODE && (child.textContent ?? "").trim());
        if (firstText) firstText.textContent = (firstText.textContent ?? "").replace(/^証明[。\.\s]*/u, "");
      };
      for (const node of topLevel()) {
        if (!isProofNode(node)) continue;
        const details = document.createElement("details");
        // `folding` は旧記事CSSが想定していた共通クラス。証明も同じ
        // details/summary の折りたたみとして扱い、既存のCSSを失わない。
        details.className = "proof-details folding";
        const summary = document.createElement("summary");
        summary.textContent = "証明.";
        const inner = document.createElement("div");
        inner.className = "proof-details-inner folding-content";
        node.parentNode?.insertBefore(details, node);
        details.append(summary, inner);
        let closed = false;
        if (node.matches(".proof")) {
          while (node.firstChild) inner.append(node.firstChild);
          removeProofLabel(inner);
          node.remove();
          closed = true;
        } else {
          removeProofLabel(node);
          inner.append(node);
          closed = closesProof(node);
        }
        let next = details.nextElementSibling;
        while (
          !closed &&
          next &&
          isRenderableBlock(next) &&
          !isHeading(next) &&
          !isMathBlock(next) &&
          !isTheoremLead(next) &&
          !isProofNode(next)
        ) {
          const following = next.nextElementSibling;
          inner.append(next);
          closed = closesProof(next);
          next = following;
        }
      }
      const proofToggle = document.querySelector<HTMLButtonElement>("[data-proof-toggle]");
      const proofs = [...mathBody.querySelectorAll<HTMLDetailsElement>("details.proof-details")];
      if (proofToggle && proofs.length > 0) {
        proofToggle.hidden = false;
        const indicator = proofToggle.querySelector<HTMLElement>("[data-proof-indicator]");
        const label = proofToggle.querySelector<HTMLElement>("[data-proof-label]");
        const setProofToggleLabel = (expanded: boolean) => {
          if (indicator) indicator.textContent = "▼";
          if (label) label.textContent = expanded ? "証明を閉じる" : "証明を展開";
          if (!indicator && !label) {
            proofToggle.textContent = expanded ? "▼ 証明を閉じる" : "▼ 証明を展開";
          }
        };
        setProofToggleLabel(false);
        proofToggle.addEventListener("click", () => {
          const expand = proofs.some((proof) => !proof.open);
          proofs.forEach((proof) => { proof.open = expand; });
          setProofToggleLabel(expand);
          proofToggle.setAttribute("aria-expanded", String(expand));
        });
      }

      // 定義・命題・定理などは Markdown の見出しではなく本文の段落から
      // 自動生成されるため、変換後のカードにも目次リンクを追加する。
      // `.thmtitle` は数式を含む見出し文字列を MathJax が置き換える前に
      // 保存しているので、目次から数式だけが消えることも防げる。
      const tocList = document.querySelector<HTMLOListElement>(".toc-list");
      const tocHeadingItems = new Map<string, HTMLLIElement>();
      tocList?.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]").forEach((link) => {
        const item = link.closest("li");
        if (item instanceof HTMLLIElement && link.dataset.tocLink) {
          tocHeadingItems.set(link.dataset.tocLink, item);
        }
      });
      const tocSubLists = new Map<string, HTMLOListElement>();
      theoremCards.forEach((card, index) => {
        // Preserve an authored directive id (`{#group}`) so [[ref:group]]
        // can resolve to the statement.  Legacy statements without an id
        // still receive the generated anchor used by the old reference
        // format.
        const id = card.id || `math-block-${index + 1}`;
        if (!card.id) card.id = id;
        if (!tocList || tocList.querySelector(`[data-math-toc="${id}"]`)) return;
        const title = card.querySelector<HTMLElement>(":scope > p > .thmtitle")?.textContent?.trim()
          || card.querySelector<HTMLElement>(":scope > .thmtitle")?.textContent?.trim()
          || (card.textContent ?? "").trim().split(/\n/u)[0]?.slice(0, 120)
          || "数学の定理・定義";
        const item = document.createElement("li");
        const previousHeading = (() => {
          let sibling = card.previousElementSibling;
          while (sibling) {
            if (isHeading(sibling)) return sibling;
            sibling = sibling.previousElementSibling;
          }
          return null;
        })();
        const headingId = previousHeading?.id ?? "";
        const headingItem = headingId ? tocHeadingItems.get(headingId) : undefined;
        const headingDepth = previousHeading?.tagName === "H3" ? 4 : 3;
        item.className = `toc-depth-${headingDepth} math-toc-entry`;
        item.dataset.mathToc = id;
        const link = document.createElement("a");
        link.href = `#${id}`;
        link.dataset.tocLink = id;
        link.textContent = title;
        item.append(link);
        if (!headingItem) {
          tocList.append(item);
          return;
        }
        let subList = headingId ? tocSubLists.get(headingId) : undefined;
        if (!subList) {
          subList = document.createElement("ol");
          subList.className = "math-toc-sublist";
          headingItem.append(subList);
          if (headingId) tocSubLists.set(headingId, subList);
        }
        subList.append(item);
      });

      // 旧Google Sitesの記事は `[記事タイトル:命題 7]` のような参照を
      // Markdownリンク相当として使っていた。Markdownの通常リンクでない
      // ため、そのままだと角括弧を含むテキストになり、遷移できない。
      // 数式SVG・既存リンク・コード中は触らず、公開記事の参照だけをリンク化する。
      const referenceMap = (() => {
        try {
          const parsed = JSON.parse(mathBody.dataset.articleReferenceMap ?? "{}");
          return parsed && typeof parsed === "object"
            ? parsed as Record<string, string>
            : {};
        } catch {
          return {};
        }
      })();
      if (Object.keys(referenceMap).length > 0 || mathBody.textContent?.includes("[[ref:")) {
        // New editor references use [[ref:identifier]]. Keep the legacy
        // [記事タイトル:命題 7] form below for older imported articles.
        // [[ref:...]] は記事タイトル（日本語を含む）または、同一記事内の
        // directive id を受け付ける。公開前のタイトルも保留表示へ変換する。
        const referencePattern = /\[\[ref:([^\]\n]+)\]\]|\[([^\]\n]+)\]/gu;
        const walker = document.createTreeWalker(mathBody, NodeFilter.SHOW_TEXT);
        const textNodes: Text[] = [];
        let current = walker.nextNode();
        while (current) {
          textNodes.push(current as Text);
          current = walker.nextNode();
        }
        textNodes.forEach((node) => {
          const parent = node.parentElement;
          if (!parent || parent.closest("a,code,pre,script,style,mjx-container,.thmtitle")) return;
          const value = node.nodeValue ?? "";
          let changed = false;
          let cursor = 0;
          const fragment = document.createDocumentFragment();
          referencePattern.lastIndex = 0;
          let match: RegExpExecArray | null;
          while ((match = referencePattern.exec(value))) {
            const referenceId = match[1]?.trim() ?? "";
            const reference = match[2]?.trim() ?? "";
            if (referenceId) {
              const target = document.getElementById(referenceId);
              fragment.append(value.slice(cursor, match.index));
              if (target?.dataset.statementNumber && target.dataset.statementLabel) {
                const link = document.createElement("a");
                link.className = "article-reference math-statement-reference";
                link.href = `#${target.id || referenceId}`;
                link.dataset.articleReference = referenceId;
                link.textContent = `${target.dataset.statementLabel} ${target.dataset.statementNumber}`;
                fragment.append(link);
              } else if (referenceMap[referenceId]) {
                const link = document.createElement("a");
                link.className = "article-reference";
                link.href = referenceMap[referenceId];
                link.dataset.articleReference = referenceId;
                link.textContent = referenceId;
                fragment.append(link);
              } else {
                const pending = document.createElement("span");
                pending.className = "article-reference article-reference-pending";
                pending.dataset.articleReference = referenceId;
                pending.title = "参照先の記事が公開されるとリンクになります";
                pending.textContent = referenceId;
                fragment.append(pending);
              }
              cursor = match.index + match[0].length;
              changed = true;
              continue;
            }
            const parts = reference.match(
              /^(.+?)\s*:\s*(?:定義|命題|定理|補題|系|例)\s*(\d+)\s*$/u,
            );
            if (!parts) continue;
            const href = parts[1] ? referenceMap[parts[1]] : undefined;
            fragment.append(value.slice(cursor, match.index));
            if (href) {
              const link = document.createElement("a");
              link.className = "article-reference";
              link.href = `${href}#math-block-${parts[2]}`;
              link.dataset.articleReference = reference;
              link.textContent = reference;
              fragment.append(link);
            } else {
              // 参照先の記事がまだ公開されていない場合、角括弧のままだと
              // 壊れたリンクに見える。文章として読める表記に留める。
              const pending = document.createElement("span");
              pending.className = "article-reference article-reference-pending";
              pending.dataset.articleReference = reference;
              pending.title = "この記事はまだ公開されていません";
              pending.textContent = reference;
              fragment.append(pending);
            }
            cursor = match.index + match[0].length;
            changed = true;
          }
          if (!changed) return;
          fragment.append(value.slice(cursor));
          node.parentNode?.replaceChild(fragment, node);
        });
      }

      // 本文中の参照リンクにホバーしたとき、リンク先の定義・命題カードを
      // X のプレビューのように表示する。タイトルそのものをトリガーにはせず、
      // 実際に読者がクリックできる本文リンクへだけ動作を付与する。
      // 数学分野の記事で、実際に本文参照リンクが生成された場合だけ有効にする。
      // 参照のない記事にはプレビューDOMやイベントを追加しない。
      if (articleMeta.dataset.subjectSlug === "mathematics") {
        const articleMain = mathBody.closest<HTMLElement>(".article-main");
        const localCards = new Map<string, HTMLElement>();
        theoremCards.forEach((card, index) => {
          if (!card.id) card.id = `math-block-${index + 1}`;
          localCards.set(card.id, card);
        });
        const referenceLinks = [...mathBody.querySelectorAll<HTMLAnchorElement>(
          "a.article-reference:not(.article-reference-pending)",
        )];
        const references = referenceLinks.flatMap((link) => {
          try {
            const url = new URL(link.href, window.location.href);
            const id = decodeURIComponent(url.hash.slice(1));
            if (!id) return [];
            return [{ link, href: url.href, id, samePage: url.origin === window.location.origin && url.pathname === window.location.pathname }];
          } catch {
            return [];
          }
        });

        if (articleMain && references.length > 0) {
          type TheoremPreview = {
            id: string;
            href: string;
            title: string;
            card?: HTMLElement;
          };
          const previews = new Map<HTMLAnchorElement, TheoremPreview>();
          const preview = document.createElement("aside");
          preview.className = "theorem-preview";
          preview.dataset.theoremPreview = "true";
          preview.hidden = true;
          preview.setAttribute("role", "dialog");
          preview.setAttribute("aria-modal", "false");
          const previewTitle = document.createElement("p");
          previewTitle.className = "theorem-preview-heading";
          const previewBody = document.createElement("div");
          previewBody.className = "theorem-preview-body";
          preview.append(previewTitle, previewBody);
          articleMain.append(preview);

          const remoteCards = new Map<string, Promise<HTMLElement | null>>();
          const loadRemoteCard = (href: string, id: string) => {
            const key = `${href}#${id}`;
            const cached = remoteCards.get(key);
            if (cached) return cached;
            const pending = (async () => {
              try {
                // 本番は X-Frame-Options: DENY を返すためiframeでは取得できない。
                // 同一オリジンのHTMLを取得し、静的HTML内の定理段落と数式を
                // 対象番号まで再構成する。将来サーバー側でIDを出力する場合は
                // その要素を優先してそのまま複製する。
                const response = await fetch(href, { credentials: "same-origin" });
                if (!response.ok) return null;
                const html = await response.text();
                const remoteDocument = new DOMParser().parseFromString(html, "text/html");
                const remoteBody = remoteDocument.querySelector<HTMLElement>(".article-body");
                if (!remoteBody) return null;
                const directTarget = remoteBody.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
                if (directTarget) return directTarget.cloneNode(true) as HTMLElement;
                const match = id.match(/^math-block-(\d+)$/u);
                const targetNumber = match ? Number(match[1]) : NaN;
                if (!Number.isFinite(targetNumber) || targetNumber < 1) return null;
                const statements = [...remoteBody.children].filter((node): node is HTMLElement =>
                  node.tagName === "P" && theoremLead.test((node.textContent ?? "").trim()),
                );
                const statement = statements[targetNumber - 1];
                if (!statement) return null;
                const card = document.createElement("div");
                card.className = "math-theorem";
                for (let node: Element | null = statement; node; node = node.nextElementSibling) {
                  if (
                    node !== statement && (
                      ["H2", "H3"].includes(node.tagName) ||
                      theoremLead.test((node.textContent ?? "").trim()) ||
                      node.matches(".proof,.proof-details,details")
                    )
                  ) break;
                  card.append(node.cloneNode(true));
                }
                return card;
              } catch {
                return null;
              }
            })();
            remoteCards.set(key, pending);
            return pending;
          };

          const renderCard = (card: HTMLElement, fallbackTitle: string) => {
            const clone = card.cloneNode(true) as HTMLElement;
            clone.removeAttribute("id");
            clone.querySelectorAll<HTMLElement>("[data-theorem-preview-trigger]").forEach((node) => {
              node.classList.remove("theorem-preview-trigger");
              node.removeAttribute("data-theorem-preview-trigger");
              node.removeAttribute("aria-expanded");
              node.removeAttribute("aria-haspopup");
            });
            const title = clone.querySelector<HTMLElement>(":scope > p > .thmtitle, :scope > .thmtitle, .thmtitle");
            if (title) {
              previewTitle.replaceChildren(...[...title.childNodes].map((node) => node.cloneNode(true)));
              title.remove();
            } else {
              previewTitle.textContent = fallbackTitle;
            }
            previewBody.replaceChildren(...[...clone.childNodes].map((node) => node.cloneNode(true)));
          };

          let activeTrigger: HTMLAnchorElement | null = null;
          let hideTimer: number | undefined;
          const cancelHide = () => {
            if (hideTimer !== undefined) window.clearTimeout(hideTimer);
            hideTimer = undefined;
          };
          const isEngaged = () => Boolean(
            activeTrigger && (
              activeTrigger.matches(":hover") ||
              document.activeElement === activeTrigger ||
              preview.matches(":hover") ||
              preview.contains(document.activeElement)
            ),
          );
          const hidePreview = () => {
            cancelHide();
            if (!activeTrigger) return;
            activeTrigger.removeAttribute("aria-expanded");
            activeTrigger = null;
            preview.hidden = true;
            preview.removeAttribute("aria-labelledby");
          };
          const scheduleHide = () => {
            cancelHide();
            hideTimer = window.setTimeout(() => {
              hideTimer = undefined;
              if (!isEngaged()) hidePreview();
            }, 140);
          };
          const positionPreview = () => {
            if (!activeTrigger || preview.hidden) return;
            const triggerRect = activeTrigger.getBoundingClientRect();
            const margin = 12;
            const previewRect = preview.getBoundingClientRect();
            const maxLeft = Math.max(margin, window.innerWidth - previewRect.width - margin);
            const left = Math.min(Math.max(margin, triggerRect.left), maxLeft);
            const below = triggerRect.bottom + 8;
            const above = triggerRect.top - previewRect.height - 8;
            const top = below + previewRect.height + margin <= window.innerHeight
              ? below
              : Math.max(margin, above);
            preview.style.left = `${Math.round(left)}px`;
            preview.style.top = `${Math.round(top)}px`;
          };
          const showPreview = async (trigger: HTMLAnchorElement) => {
            const data = previews.get(trigger);
            if (!data) return;
            cancelHide();
            activeTrigger = trigger;
            previewTitle.textContent = data.title;
            previewBody.textContent = "読み込み中…";
            preview.setAttribute("aria-labelledby", "theorem-preview-title");
            previewTitle.id = "theorem-preview-title";
            trigger.setAttribute("aria-expanded", "true");
            preview.hidden = false;
            positionPreview();
            const card = data.card ?? await loadRemoteCard(data.href, data.id);
            if (card && activeTrigger === trigger) {
              renderCard(card, data.title);
              positionPreview();
            } else if (activeTrigger === trigger) {
              previewBody.textContent = "リンク先の本文を読み込めませんでした。";
              positionPreview();
            }
          };
          const bindTrigger = (trigger: HTMLAnchorElement, data: TheoremPreview) => {
            previews.set(trigger, data);
            trigger.classList.add("theorem-preview-trigger");
            trigger.dataset.theoremPreviewTrigger = data.id;
            trigger.setAttribute("aria-haspopup", "dialog");
            trigger.addEventListener("pointerenter", () => { void showPreview(trigger); });
            trigger.addEventListener("pointerleave", scheduleHide);
            trigger.addEventListener("focus", () => { void showPreview(trigger); });
            trigger.addEventListener("blur", scheduleHide);
            trigger.addEventListener("keydown", (event) => {
              if (event.key === "Escape") {
                event.preventDefault();
                hidePreview();
              }
            });
          };

          references.forEach(({ link, href, id, samePage }) => {
            const card = samePage ? localCards.get(id) : undefined;
            if (!card && samePage) return;
            bindTrigger(link, {
              id,
              href,
              title: link.textContent?.replace(/\s+/gu, " ").trim() || id,
              card,
            });
          });

          preview.addEventListener("pointerenter", cancelHide);
          preview.addEventListener("pointerleave", scheduleHide);
          window.addEventListener("resize", positionPreview, { passive: true });
          window.addEventListener("scroll", positionPreview, { passive: true });
          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !preview.hidden) hidePreview();
          });
        }
      }
    }
  }
</script>

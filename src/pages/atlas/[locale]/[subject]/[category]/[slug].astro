---
/** 個別記事ページ */
import { render } from "astro:content";
import AtlasLayout from "../../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";
import HistoryStageControl from "../../../../../components/HistoryStageControl.astro";
import {
  atlasPath,
  articlePath,
  formatDate,
  withBase,
} from "../../../../../lib/site";
import {
  t,
  LOCALES,
  localizedName,
  localeNames,
  type Locale,
} from "../../../../../lib/i18n";
import {
  getPublishedArticles,
  getPublishedSubjects,
  getConcepts,
  indexArticlesByConcept,
  prerequisiteArticles,
  relatedArticles,
  nextArticles,
  translationArticles,
} from "../../../../../lib/content";
import { ORG } from "../../../../../lib/site";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((a) => ({
    params: {
      locale: a.data.locale,
      subject: a.data.subject,
      category: a.data.category,
      slug: a.data.slug,
    },
    props: { entry: a },
  }));
}

const { entry } = Astro.props;
const locale = entry.data.locale as Locale;
const { Content, headings } = await render(entry);

const { map } = await getConcepts();
const sameLocale = await getPublishedArticles(locale);
const all = await getPublishedArticles();
const byConcept = indexArticlesByConcept(sameLocale);

const prereqs = prerequisiteArticles(entry, map, byConcept);
const related = relatedArticles(entry, map, byConcept);
const next = nextArticles(entry, map, byConcept, sameLocale);
const translations = translationArticles(entry, all);

// 本文中の参照（`[記事タイトル:命題 7]` / `[[ref:記事タイトル]]`）を、
// 同じ言語の公開記事へのリンクへ戻すための最小マップ。本文全体ではなく、
// 実際に参照されているタイトルだけを埋め込むので、ページサイズも抑える。
const referencedArticleTitles = new Set<string>();
for (const match of entry.body?.matchAll(/\[([^\]:]+):\s*(?:定義|命題|定理|補題|系|例)\s*\d+\]/gu) ?? []) {
  const title = match[1]?.trim();
  if (title) referencedArticleTitles.add(title);
}
for (const match of entry.body?.matchAll(/\[\[ref:([^\]\n]+)\]\]/gu) ?? []) {
  const title = match[1]?.trim();
  if (title) referencedArticleTitles.add(title);
}
const articleReferenceMap = Object.fromEntries(
  [...referencedArticleTitles]
    .flatMap((title) => {
      const target = all.find(
        (article) =>
          article.data.locale === locale && article.data.title === title,
      );
      return target
        ? [[
            title,
            articlePath(
              target.data.locale,
              target.data.subject,
              target.data.category,
              target.data.slug,
            ),
          ] as const]
        : [];
    }),
);

const subjects = await getPublishedSubjects();
const subject = subjects.find((s) => s.data.slug === entry.data.subject);
const category = subject?.data.categories.find(
  (c) => c.slug === entry.data.category,
);
const subjectName = subject
  ? localizedName(subject.data.name, locale)
  : entry.data.subject;
const categoryName = category
  ? localizedName(category.name, locale)
  : entry.data.category;

/**
 * MathJax は見出し内の数式を SVG に置き換えるため、Astro の見出し一覧では
 * `$G$` のようなインライン数式が空文字になったり、MathML の補助文字まで
 * 連結されたりすることがある。目次だけはMarkdown原文からラベルを復元し、
 * 数式の文字を落とさないようにする。
 */
const isStructuralLabel = (text: string) => /^【.+】$/u.test(text.trim());
const rawHeadingEntries: Array<{ depth: number; text: string }> = [];
if (typeof entry.body === "string") {
  let inFence = false;
  for (const line of entry.body.split(/\r?\n/u)) {
    if (/^\s*(```|~~~)/u.test(line)) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    const match = line.match(/^(#{1,3})\s+(.+?)\s*#*\s*$/u);
    if (match?.[1] && match[2]) {
      rawHeadingEntries.push({
        depth: match[1].length,
        text: match[2].trim().replace(/\s+\{#[A-Za-z][\w:-]*\}\s*$/u, ""),
      });
    }
  }
}
const rawTocEntries = rawHeadingEntries.filter(
  (h) => h.depth <= 3 && !(h.depth === 3 && isStructuralLabel(h.text)),
);
const toc = headings
  .filter((h) => h.depth <= 3 && !(h.depth === 3 && isStructuralLabel(h.text)))
  .map((heading, index) => ({
    ...heading,
    text: rawTocEntries[index]?.text ?? heading.text,
  }));

const inlineMathSymbols: Record<string, string> = {
  colon: ":",
  cdot: "·",
  cong: "≅",
  in: "∈",
  mapsto: "↦",
  mathbb: "",
  mathcal: "",
  mathfrak: "",
  mathrm: "",
  neq: "≠",
  notin: "∉",
  partial: "∂",
  pm: "±",
  rightarrow: "→",
  sim: "∼",
  subset: "⊂",
  subseteq: "⊆",
  times: "×",
  to: "→",
  forall: "∀",
};
const unwrapMathCommands = (value: string): string => {
  let result = value;
  // Nested commands such as `\\mathop{\\mathrm{Ker}}` need more than one pass.
  for (let pass = 0; pass < 4; pass += 1) {
    const next = result.replace(
      /\\(?:mathrm|mathbb|mathbf|mathcal|mathfrak|mathit|mathsf|mathtt|operatorname|mathop|text|boldsymbol|bm)\s*\{([^{}]*)\}/gu,
      "$1",
    );
    if (next === result) break;
    result = next;
  }
  return result
    .replace(/\\([A-Za-z]+)\s*/gu, (_command, name: string) => inlineMathSymbols[name] ?? "")
    .replace(/[{}]/gu, "")
    .replace(/\s+/gu, " ")
    .trim();
};
const tocLabel = (text: string) =>
  text
    .replace(/\s+\{#[A-Za-z][\w:-]*\}\s*$/u, "")
    .replace(/\$([^$]+)\$/gu, (_math, value: string) => unwrapMathCommands(value))
    .replace(/[*_`]/gu, "")
    .replace(/\s+/gu, " ")
    .trim();

/** 言語切替: 対応記事があればそこへ、なければ各言語の総合ホームへ */
const localeSwitchHrefs: Record<string, string> = {};
for (const l of LOCALES) {
  if (l === locale) continue;
  const targets = translations.get(l);
  if (targets && targets.length > 0 && targets[0]) {
    const tgt = targets[0];
    localeSwitchHrefs[l] = articlePath(
      l,
      tgt.data.subject,
      tgt.data.category,
      tgt.data.slug,
    );
  }
}

const alternates = [...translations.entries()].flatMap(([l, arts]) =>
  arts.length > 0 && arts[0]
    ? [
        {
          hreflang: l,
          href: new URL(
            articlePath(
              l,
              arts[0].data.subject,
              arts[0].data.category,
              arts[0].data.slug,
            ),
            Astro.site,
          ).href,
        },
      ]
    : [],
);

const conceptNames = entry.data.concepts.map((c) => {
  const node = map.get(c.id);
  return { id: c.id, name: node ? localizedName(node.name, locale) : c.id };
});
const historyUrl = `${ORG.githubRepo}/commits/main/src/content/articles/${entry.id}.md`;
const ogImage = new URL(
  withBase(
    `/og/${entry.data.locale}/${entry.data.subject}/${entry.data.category}/${entry.data.slug}.png`,
  ),
  Astro.site,
).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.summary,
  url: new URL(
    articlePath(locale, entry.data.subject, entry.data.category, entry.data.slug),
    Astro.site,
  ).href,
  inLanguage: locale,
  dateModified: entry.data.updatedAt.toISOString(),
  datePublished: entry.data.createdAt.toISOString(),
  // frontmatter の authors は "atlas-math-team" のような内部IDなので、
  // 人名として出さず団体を著者にする。
  author: { "@type": "Organization", name: "Atlasez" },
  publisher: {
    "@type": "Organization",
    name: "Atlasez",
    url: Astro.site?.href,
  },
};

---

<AtlasLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType="image/png"
  alternates={alternates}
  structuredData={structuredData}
  localeSwitchHrefs={localeSwitchHrefs}
>
  {/* 記事のどこまで読んだかを示す帯。装飾なので支援技術からは隠す */}
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" data-reading-progress></div>
  </div>

  <div class="container article-layout">
    {/* 左: 記事内目次（デスクトップは固定、モバイルは折り畳み） */}
    <nav class="article-toc" id="article-toc" aria-label={t(locale, "toc")}>
      <details class="toc-details" open>
        <summary>{t(locale, "toc")}</summary>
        <ol class="details-body toc-list">
          {
            toc.map((h) => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>
                  {tocLabel(h.text)}
                </a>
              </li>
            ))
          }
        </ol>
      </details>
    </nav>
    <button
      type="button"
      class="mobile-toc-trigger"
      data-mobile-toc
      aria-controls="article-toc"
      aria-expanded="false"
    >
      <span class="mobile-toc-label">{t(locale, "toc")}</span>
    </button>

    {/* 中央: 本文（Pagefindの検索対象） */}
    <article class="article-main" data-pagefind-body>
      <Breadcrumb
        items={[
          { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
          { label: subjectName, href: atlasPath(locale, entry.data.subject) },
          {
            label: categoryName,
            href: atlasPath(locale, entry.data.subject, entry.data.category),
          },
          { label: entry.data.title },
        ]}
      />
      <div class="visually-hidden">
        {/* Pagefind用のフィルタ・メタデータ（検索の絞り込みに使用） */}
        <span data-pagefind-filter="subject">{subjectName}</span>
        <span data-pagefind-filter="category">{categoryName}</span>
        <span data-pagefind-filter="locale">{localeNames[locale]}</span>
        <span data-pagefind-meta="summary">{entry.data.summary}</span>
        {entry.data.aliases.map((al) => <span>{al}</span>)}
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
        {entry.data.concepts.map((c) => <span>{c.id}</span>)}
      </div>
      {
        conceptNames.length > 0 && (
          <section
            class="article-concept-nodes"
            aria-label={locale === "ja" ? "この記事の主要概念" : "Main concepts in this article"}
          >
            <span>{locale === "ja" ? "主要概念" : "Main concepts"}</span>
            <div>
              {
                conceptNames.map((concept) => (
                  <a
                    href={`${atlasPath(locale, entry.data.subject, entry.data.category)}?view=map&selected=${encodeURIComponent(concept.id)}`}
                  >
                    {concept.name}
                  </a>
                ))
              }
            </div>
          </section>
        )
      }
      <header class="article-header">
        <div class="article-title-row">
          <h1 id="article-title">{entry.data.title}</h1>
          {/* 要約は本文冒頭と重複しがちなので記事ページでは出さない。
              一覧ページ・検索結果・meta description では引き続き使う。 */}
          <p class="article-badges">
            <span class="badge">
              {t(locale, "updatedAt")}:
              <time datetime={entry.data.updatedAt.toISOString().slice(0, 10)}>
                {formatDate(entry.data.updatedAt, locale)}
              </time>
            </span>
          </p>
        </div>
        {/* 「あとで読む」= これから読むもの / 「読んだ・理解した」= 済んだもの */}
        <div
          class="article-actions"
          data-article-actions
          data-article-id={entry.data.articleId}
          data-locale={locale}
          data-title={entry.data.title}
          data-href={articlePath(
            locale,
            entry.data.subject,
            entry.data.category,
            entry.data.slug,
          )}
          data-subject={subjectName}
          data-category={categoryName}
          data-subject-slug={entry.data.subject}
          data-category-slug={entry.data.category}
          data-summary={entry.data.summary}
          data-label-copied={t(locale, "linkCopied")}
          data-label-share-failed={t(locale, "shareFailed")}
        >
          <button
            type="button"
            class="bookmark-btn"
            data-bookmark-toggle
            data-label-save={t(locale, "saveForLater")}
            data-label-saved={t(locale, "saved")}
            aria-pressed="false"
          >
            <span data-bookmark-icon aria-hidden="true">☆</span>
            <span data-bookmark-label>{t(locale, "saveForLater")}</span>
          </button>
          <HistoryStageControl locale={locale} />
          <button
            type="button"
            class="article-icon-btn"
            data-article-share
            aria-label={t(locale, "shareArticle")}
            title={t(locale, "shareArticle")}
          >
            <svg
              class="article-share-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="m8.05 10.9 7.9-4.65M8.05 13.1l7.9 4.65"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="2.2"
              />
              <circle cx="6" cy="12" r="2.25" fill="currentColor" />
              <circle cx="18" cy="5" r="2.25" fill="currentColor" />
              <circle cx="18" cy="19" r="2.25" fill="currentColor" />
            </svg>
          </button>
          <button
            type="button"
            class="article-icon-btn"
            data-article-copy
            aria-label={t(locale, "copyLink")}
            title={t(locale, "copyLink")}
          >
            <svg
              class="article-copy-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M10.6 13.4a4.2 4.2 0 0 0 5.95.01l2.1-2.1a4.2 4.2 0 0 0-5.95-5.95l-1.2 1.2M13.4 10.6a4.2 4.2 0 0 0-5.95-.01l-2.1 2.1a4.2 4.2 0 0 0 5.95 5.95l1.2-1.2"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.4"
              />
            </svg>
          </button>
          <span
            class="article-action-status"
            data-article-action-status
            aria-live="polite"
          ></span>
        </div>
        {
          [...translations.entries()].length > 0 && (
            <p class="translation-info">
              {t(locale, "availableIn")}:
              {[...translations.entries()].map(([l, arts]) => (
                <span class="translation-links">
                  {arts.map((a2) => (
                    <a
                      href={articlePath(
                        l,
                        a2.data.subject,
                        a2.data.category,
                        a2.data.slug,
                      )}
                      hreflang={l}
                      lang={l}
                    >
                      {localeNames[l]}: {a2.data.title}
                    </a>
                  ))}
                </span>
              ))}
            </p>
          )
        }
      </header>

      {
        entry.data.exerciseIds.pre.length > 0 && (
          <div class="article-exercise" role="note">
            <span class="badge">
              {t(locale, "preExercise")}（{t(locale, "preparing")}）
            </span>
          </div>
        )
      }

      {
        entry.data.subject === "mathematics" && (
          <button
            class="proof-toggle"
            type="button"
            data-proof-toggle
            aria-expanded="false"
            hidden
          >
            <span class="proof-toggle-icon" data-proof-indicator aria-hidden="true">▼</span>{" "}<span data-proof-label>証明を展開</span>
          </button>
        )
      }

      <div
        class:list={[
          "article-body",
          "reading",
          entry.data.subject === "mathematics" && "math-article",
          entry.data.subject === "kanji" && "kanji-article",
        ]}
        data-subject={entry.data.subject}
        data-article-reference-map={JSON.stringify(articleReferenceMap)}
      >
        <Content />
      </div>

      <div class="article-bottom-history">
        <HistoryStageControl locale={locale} />
      </div>

      {
        entry.data.exerciseIds.post.length > 0 && (
          <div class="article-exercise" role="note">
            <span class="badge">
              {t(locale, "postExercise")}（{t(locale, "preparing")}）
            </span>
          </div>
        )
      }

      <section aria-labelledby="refs-heading" class="article-refs">
        <h2 id="refs-heading">{t(locale, "references")}</h2>
        {
          entry.data.references.length > 0 ? (
            <ul>
              {entry.data.references.map((r) => (
                <li>
                  {r.url ? (
                    <a href={r.url} rel="noopener noreferrer" target="_blank">
                      {r.title}
                    </a>
                  ) : (
                    r.title
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="reference-status">
              {locale === "ja"
                ? "この記事には参考文献がまだ登録されていません。内容を検証する際は、記事下部の報告リンクをご利用ください。"
                : "No references have been registered for this article yet."}
            </p>
          )
        }
      </section>

      <footer class="article-footer">
        <div class="article-footer-links">
          <section class="issue-report" aria-labelledby="issue-report-heading">
            <h2 id="issue-report-heading">{t(locale, "reportIssue")}</h2>
            <p class="issue-report-note">
              {locale === "ja"
                ? "記事名・URLは自動で添付されます。誤りや改善案をこの画面からお送りください。"
                : "The article title and URL are attached automatically. Send an error report or suggestion here."}
            </p>
            <form
              class="issue-report-form"
              data-issue-report-form
              data-article-title={entry.data.title}
              data-article-id={entry.data.articleId}
              data-article-subject={entry.data.subject}
              data-article-category={entry.data.category}
              data-locale={locale}
            >
              <div class="issue-report-fields">
                <label>
                  {locale === "ja" ? "報告の種類" : "Report type"}
                  <select name="reportType" required>
                    <option value="error">{locale === "ja" ? "誤り・誤植" : "Error or typo"}</option>
                    <option value="suggestion">{locale === "ja" ? "改善の提案" : "Suggestion"}</option>
                    <option value="reference">{locale === "ja" ? "出典・参考文献" : "Reference"}</option>
                    <option value="other">{locale === "ja" ? "その他" : "Other"}</option>
                  </select>
                </label>
                <label>
                  {locale === "ja" ? "内容" : "Details"}
                  <textarea
                    name="details"
                    rows="5"
                    required
                    maxlength="6000"
                    placeholder={locale === "ja" ? "該当箇所と、どのように修正すべきかをお書きください。" : "Describe the relevant section and the proposed correction."}
                  ></textarea>
                </label>
                <label>
                  {locale === "ja" ? "返信先（任意）" : "Reply address (optional)"}
                  <input name="contact" type="email" maxlength="320" autocomplete="email" />
                </label>
                <label class="issue-report-trap" aria-hidden="true">
                  Website
                  <input name="website" type="text" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <div class="issue-report-actions">
                <button type="submit" class="button">
                  {locale === "ja" ? "報告を送信" : "Send report"}
                </button>
                <p data-issue-report-status aria-live="polite"></p>
              </div>
            </form>
          </section>
          <a href={historyUrl} rel="noopener noreferrer" target="_blank">
            {t(locale, "editOnGitHub")}
          </a>
        </div>
      </footer>
    </article>

    {/* 右: 記事情報・関連 */}
    <aside class="article-aside" aria-label={locale === "ja" ? "記事情報" : "Article info"}>
      <section>
        <h2>{locale === "ja" ? "記事情報" : "Article info"}</h2>
        <dl class="meta-list">
          {
            /* 執筆者は frontmatter に "atlas-math-team" のような内部IDしか
               入っておらず、読者にとって意味をなさないので表示しない。
               実名で載せられるようになったら復活させる。 */
          }
          <dt>{t(locale, "conceptsCovered")}</dt>
          <dd>
            <ul class="concept-list">
              {conceptNames.map((c) => <li>{c.name}</li>)}
            </ul>
          </dd>
        </dl>
      </section>
      {
        prereqs.length > 0 && (
          <section>
            <h2>{t(locale, "prerequisiteArticles")}</h2>
            <ul class="aside-links">
              {prereqs.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        next.length > 0 && (
          <section>
            <h2>{t(locale, "nextArticles")}</h2>
            <ul class="aside-links">
              {next.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        related.length > 0 && (
          <section>
            <h2>{t(locale, "relatedArticles")}</h2>
            <ul class="aside-links">
              {related.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</AtlasLayout>

<style>
  /*
   * 読み進み具合の帯。画面上端に固定し、記事本文の位置に応じて伸びる。
   * 高さ 3px の装飾なので、内容は目次の現在地強調（scroll-spy）が担う。
   */
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: 3px;
    background: transparent;
    pointer-events: none;
  }
  .reading-progress-bar {
    width: 0;
    height: 100%;
    background: var(--accent-primary);
    transition: width 80ms linear;
  }
  [data-pref-motion="reduced"] .reading-progress-bar {
    transition: none;
  }

  .article-bottom-history {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-default);
  }

  .article-concept-nodes {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-3) 0;
  }
  .article-concept-nodes > span {
    color: var(--text-secondary);
    font-size: calc(.82rem * var(--text-scale));
    font-weight: 700;
  }
  .article-concept-nodes > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .article-concept-nodes a {
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    color: var(--text-primary);
    padding: .35rem .6rem;
    text-decoration: none;
  }
  .article-concept-nodes a:hover {
    background: var(--accent-primary);
    color: var(--background-primary);
  }

  /* 本文カラムを広く取るため、コンテナ幅を広げ左右カラムを絞っている */
  .article-layout {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr) 14rem;
    gap: var(--space-4);
    align-items: start;
    max-width: 86rem;
  }
  .article-toc {
    position: sticky;
    top: var(--space-3);
    font-size: calc(0.9rem * var(--text-scale));
    max-height: calc(100vh - var(--space-5));
    overflow-y: auto;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
  }
  .toc-list a {
    display: block;
    padding: var(--space-1) var(--space-2);
    text-decoration: none;
    color: var(--text-secondary);
    border-left: 3px solid transparent;
  }
  .toc-list a:hover {
    color: var(--accent-primary);
  }
  .toc-list a[aria-current="true"] {
    border-left-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 600;
    background: var(--accent-subtle);
  }
  .toc-depth-3 a {
    padding-left: var(--space-4);
  }
  .toc-depth-4 a {
    padding-left: var(--space-5);
  }
  /* 数学枠の目次項目はクライアント側で追加されるため、子要素は
     :global() で指定してAstroのスコープ属性に依存しないようにする。 */
  .article-toc :global(.math-toc-sublist) {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-2);
  }
  .article-toc :global(.math-toc-sublist a) {
    display: block;
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-4);
    border-left: 3px solid transparent;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .article-toc :global(.math-toc-sublist .toc-depth-4 a) {
    padding-left: var(--space-5);
  }
  .article-toc :global(.math-toc-sublist a:hover) {
    color: var(--accent-primary);
  }
  .article-toc :global(.math-toc-sublist a[aria-current="true"]) {
    border-left-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 600;
    background: var(--accent-subtle);
  }
  .article-header {
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--accent-primary);
  }
  .article-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .article-title-row h1 {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .article-badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    flex: 0 0 auto;
    justify-content: flex-end;
    margin: 0;
  }
  .article-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .bookmark-btn {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius, 4px);
    background: transparent;
    color: var(--accent-primary);
    font: inherit;
    font-size: calc(0.9rem * var(--text-scale));
    cursor: pointer;
  }
  .bookmark-btn:hover {
    background: var(--accent-subtle);
  }
  .bookmark-btn[aria-pressed="true"] {
    background: var(--accent-primary);
    color: var(--bg, #fff);
  }
  /* 学習の記録は「あとで読む」と役割が違うので、枠線の色で区別する */
  .history-btn {
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }
  .history-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  .article-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target, 2.75rem);
    min-width: var(--touch-target, 2.75rem);
    height: var(--touch-target, 2.75rem);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius, 4px);
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .article-icon-btn:hover,
  .article-icon-btn:focus-visible {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: var(--accent-subtle);
  }
  .article-share-icon {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
  }
  .article-copy-icon {
    display: block;
    width: 1.45rem;
    height: 1.45rem;
  }
  .article-action-status {
    align-self: center;
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
  }
  .translation-info {
    font-size: calc(0.9rem * var(--text-scale));
  }
  .translation-links {
    margin-inline-start: var(--space-2);
  }
  .article-exercise {
    margin-block: var(--space-3);
  }
  .article-body {
    margin-block: var(--space-3);
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
  }
  .article-body :global(h2) {
    border-bottom: 1px solid var(--border-default);
    padding-bottom: var(--space-1);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .article-body :global(h3) {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
  }
  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-block: 0.7em;
  }
  /* 漢字記事は一字と読みを表で引けるよう、本文とは別の視線誘導を用意する。 */
  .article-body.kanji-article {
    line-height: 1.9;
  }
  .article-body.kanji-article :global(h2) {
    background: color-mix(in srgb, var(--accent-primary) 8%, var(--background-primary));
    border-bottom: 0;
    border-left: 4px solid var(--accent-primary);
    border-radius: 0 .35rem .35rem 0;
    margin-top: var(--space-5);
    padding: .55rem .75rem;
  }
  .article-body.kanji-article :global(h3) {
    border-bottom: 1px solid var(--border-default);
    color: var(--accent-primary);
    font-size: calc(1rem * var(--text-scale));
    margin-top: var(--space-4);
    padding-bottom: .25rem;
  }
  .article-body.kanji-article :global(table) {
    border: 1px solid var(--border-default);
    border-radius: .35rem;
    display: table;
    margin: 1rem 0 1.4rem;
    overflow: hidden;
  }
  .article-body.kanji-article :global(th),
  .article-body.kanji-article :global(td) {
    border-bottom: 1px solid var(--border-default);
    padding: .55rem .7rem;
    vertical-align: middle;
  }
  .article-body.kanji-article :global(th) {
    background: var(--accent-subtle);
    color: var(--text-primary);
    font-size: .78em;
    letter-spacing: .04em;
    white-space: nowrap;
  }
  .article-body.kanji-article :global(td:first-child) {
    color: var(--text-primary);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
    font-size: 1.35em;
    font-weight: 700;
    text-align: center;
    width: 5rem;
  }
  .article-body.kanji-article :global(tr:last-child td) {
    border-bottom: 0;
  }
  @media (max-width: 767px) {
    .article-body.kanji-article :global(table) {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }
  }
  /* 数学本文だけに記事用の組版ルールを限定する。サイト共通の
     リスト・カード用スタイルが定義枠へ漏れないよう、math-article を
     境界クラスとして使う。 */
  .article-body.math-article :global(ol) {
    list-style: decimal outside;
    padding-inline-start: 1.55rem;
  }
  .article-body.math-article :global(ul) {
    list-style: disc outside;
    padding-inline-start: 1.55rem;
  }
  .article-body.math-article :global(ol > li),
  .article-body.math-article :global(ul > li) {
    display: list-item;
    padding-inline-start: 0.15rem;
  }
  /* 旧数学サイトの図は本文内のSVGとして移行する。外部画像に依存せず、
     記事幅とスマホ幅の両方に収まるfigureとして扱う。 */
  .article-body.math-article :global(.math-figure) {
    box-sizing: border-box;
    margin: 1.5rem auto;
    max-width: 100%;
    text-align: center;
  }
  .article-body.math-article :global(.math-figure > img),
  .article-body.math-article :global(.math-figure > svg) {
    display: block;
    height: auto;
    margin-inline: auto;
    max-width: 100%;
    width: auto;
  }
  /* TikZ is compiled to inline SVG at build time. Keep the diagram inside
     the article column on narrow screens and let it follow the article color
     for uncoloured strokes/text. */
  .article-body.math-article :global(.tikz-diagram) {
    box-sizing: border-box;
    color: var(--text-primary);
    margin: 1.5rem auto;
    max-width: 100%;
    overflow-x: auto;
    text-align: center;
  }
  .article-body.math-article :global(.tikz-diagram > svg) {
    display: inline-block;
    height: auto;
    max-width: 100%;
    vertical-align: middle;
  }
  .article-body.math-article :global(.tikz-error) {
    background: color-mix(in srgb, var(--danger, #b42318) 7%, var(--background-primary));
    border: 1px solid color-mix(in srgb, var(--danger, #b42318) 30%, var(--border-default));
    border-left: 3px solid var(--danger, #b42318);
    border-radius: .35rem;
    color: var(--text-primary);
    display: grid;
    gap: .25rem;
    margin: 1rem 0;
    padding: .7rem .85rem;
    text-align: start;
  }
  .article-body.math-article :global(.tikz-error span) {
    color: var(--text-secondary);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: .82em;
    overflow-wrap: anywhere;
  }
  .article-body.math-article :global(strong),
  .article-body.math-article :global(b) {
    font-weight: 700;
    font-synthesis: weight;
  }
  .article-body.math-article :global(.defi strong),
  .article-body.math-article :global(.defi b),
  .article-body.math-article :global(.math-definition strong),
  .article-body.math-article :global(.math-definition b) {
    font-weight: 700;
  }
  .article-body.math-article :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  /* 数学記事の定義・命題・定理は、サンプル記事の見た目を保ちつつ
     サイトのテーマ色に追従する。Markdown内の .defi/.prop 等にも、
     自動判定した記事本文にも同じスタイルを適用する。 */
  .article-body.math-article :global(.defi),
  .article-body.math-article :global(.math-definition) {
    background: color-mix(in srgb, #6cb4c2 10%, var(--background-primary));
    border: 1px solid color-mix(in srgb, #6cb4c2 35%, var(--border-default));
    border-left: 3px solid #6cb4c2;
    border-radius: 0 0.55rem 0.55rem 0.55rem;
    box-shadow: 0 2px 5px rgb(0 0 0 / 4%);
    margin-block: 2.8rem 1.15rem;
    padding: 1.1rem 1.25rem;
    box-sizing: border-box;
    min-width: 0;
    overflow: visible;
  }
  .article-body.math-article :global(.prop),
  .article-body.math-article :global(.thm),
  .article-body.math-article :global(.lemma),
  .article-body.math-article :global(.cor),
  .article-body.math-article :global(.math-theorem) {
    background: color-mix(in srgb, #e0c375 12%, var(--background-primary));
    border: 1px solid #e0c375;
    border-left-width: 3px;
    border-radius: 0 0.55rem 0.55rem 0.55rem;
    box-shadow: 0 2px 5px rgb(0 0 0 / 4%);
    margin-block: 2.8rem 1.15rem;
    padding: 1.1rem 1.25rem;
    box-sizing: border-box;
    min-width: 0;
    overflow: visible;
  }
  /* 例は意味上のグループであり、命題・定理と同じカード枠は付けない。 */
  .article-body.math-article :global(.example) {
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    margin-block: 2.2rem 1.15rem;
    padding: 0;
  }
  .article-body.math-article :global(.defi) > :first-child,
  .article-body.math-article :global(.prop) > :first-child,
  .article-body.math-article :global(.thm) > :first-child,
  .article-body.math-article :global(.lemma) > :first-child,
  .article-body.math-article :global(.cor) > :first-child,
  .article-body.math-article :global(.example) > :first-child,
  .article-body.math-article :global(.math-definition) > :first-child,
  .article-body.math-article :global(.math-theorem) > :first-child { margin-top: 0; }
  .article-body.math-article :global(.defi) > :last-child,
  .article-body.math-article :global(.prop) > :last-child,
  .article-body.math-article :global(.thm) > :last-child,
  .article-body.math-article :global(.lemma) > :last-child,
  .article-body.math-article :global(.cor) > :last-child,
  .article-body.math-article :global(.example) > :last-child,
  .article-body.math-article :global(.math-definition) > :last-child,
  .article-body.math-article :global(.math-theorem) > :last-child { margin-bottom: 0; }
  .article-body.math-article :global(.thmtitle) {
    background: #6cb4c2;
    border-radius: 0.45rem 0.45rem 0 0;
    color: #12333a;
    display: block;
    float: left;
    font-size: 0.95em;
    font-weight: 800;
    /* 見出し下端を枠本文の上端に揃える（元CSSの行高・paddingに合わせた値）。 */
    /* 現行本文の枠線(1px)・内側余白(1.1rem)とタイトルの
       行高/上下paddingを合算し、下端を枠の上端へぴったり揃える。 */
    margin: -51.4px 0 0 -23px;
    line-height: 1.5;
    padding: 4px 14px;
    border: 3px solid;
    border-color: #6cb4c2;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    box-sizing: border-box;
  }
  .article-body.math-article :global(.defi > p:first-child::after),
  .article-body.math-article :global(.prop > p:first-child::after),
  .article-body.math-article :global(.thm > p:first-child::after),
  .article-body.math-article :global(.lemma > p:first-child::after),
  .article-body.math-article :global(.cor > p:first-child::after),
  .article-body.math-article :global(.example > p:first-child::after) {
    content: "";
    display: table;
    clear: both;
  }
  .article-body.math-article :global(.prop .thmtitle),
  .article-body.math-article :global(.thm .thmtitle),
  .article-body.math-article :global(.lemma .thmtitle),
  .article-body.math-article :global(.cor .thmtitle),
  .article-body.math-article :global(.example .thmtitle) {
    background: #e0c375;
    border-color: #e0c375;
    color: #4b3a12;
  }
  /* 例には枠を付けないため、タイトルを枠の上辺へ重ねる負のマージンは
     使えない。定義・命題と同じ塊のラベルとして単独の行に置き、本文を
     次の行から始めることで、他の数学ブロックと読み方を揃える。 */
  .article-body.math-article :global(.example .thmtitle) {
    display: block;
    float: none;
    width: fit-content;
    max-width: 100%;
    margin: 0 0 0.5rem;
    border: 3px solid #e0c375;
    border-radius: 6px;
  }
  .article-body.math-article :global(.proof-details) { margin-block: 1.2rem; }
  .article-body.math-article :global(.proof-details > summary) {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-radius: 0.4rem;
    cursor: pointer;
    display: inline-block;
    font-weight: 800;
    padding: .35rem .8rem .35rem 2rem;
  }
  .article-body.math-article :global(.proof-details > summary:hover) { border-color: var(--accent-primary); }
  .article-body.math-article :global(.proof-details-inner) {
    border-left: 3px solid var(--border-default);
    margin: 0.4rem 0 0 0.35rem;
    padding: 0.2rem 0.95rem;
  }
  /* 証明本文は上下の線を持たせず、左のガイド線だけで枠を示す。 */
  .article-body.math-article :global(.proof-details),
  .article-body.math-article :global(.proof) {
    border-block: 0;
    margin-block: 1.2rem;
  }
  .article-body.math-article :global(.proof-details-inner) {
    border-block: 0;
    border-inline-end: 0;
  }
  .proof-toggle {
    position: sticky;
    top: 1rem;
    /* folding 枠が後続の本文で重なっても、証明の一括開閉操作を
       常に前面で押せるようにする。目次（45）より上、ヘッダー外の
       記事内操作として十分なスタッキングレベルを確保する。 */
    z-index: 60;
    /* ブロック幅を確保して auto マージンで右端へ寄せつつ、
       flex の中央揃えでラベルが常にボタン中央に来るようにする。 */
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: fit-content;
    margin: 4pt 4pt 4pt auto;
    min-height: 2.6rem;
    min-width: 8.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--accent-primary);
    border-radius: 0.45rem;
    background: var(--accent-primary);
    color: var(--on-accent);
    box-shadow: 0 0.25rem 0.8rem rgb(0 0 0 / 15%);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    white-space: nowrap;
  }
  .proof-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 1.1em;
    line-height: 1;
    margin-inline-end: 0.2rem;
    text-align: center;
    transform: rotate(-90deg);
    transition: transform 120ms ease;
  }
  .proof-toggle[aria-expanded="true"] .proof-toggle-icon {
    transform: rotate(0deg);
  }
  .article-body :global(.article-reference-pending) {
    border-bottom: 1px dotted var(--border-strong);
    color: var(--text-secondary);
    cursor: help;
    text-decoration: none;
  }
  /* 本文中の定理・定義参照リンクに表示する内容プレビュー。
     ポップオーバー本体は本文のDOMへ動的に追加するため、子要素は
     :global() で指定する。 */
  .article-main :global(.theorem-preview-trigger) {
    cursor: help;
    text-decoration: underline dotted color-mix(in srgb, currentColor 55%, transparent);
    text-underline-offset: 0.16em;
  }
  .article-main :global(.theorem-preview) {
    background: var(--background-primary);
    border: 1px solid var(--border-strong);
    border-radius: 0.45rem;
    box-shadow: 0 0.8rem 2.2rem rgb(0 0 0 / 18%);
    color: var(--text-primary);
    max-height: min(22rem, calc(100vh - 1.5rem));
    overflow: auto;
    padding: 0.8rem 0.95rem 0.9rem;
    position: fixed;
    width: min(23rem, calc(100vw - 1.5rem));
    z-index: 60;
  }
  .article-main :global(.theorem-preview-heading) {
    color: var(--text-primary);
    font-size: 0.98rem;
    font-weight: 750;
    line-height: 1.45;
    margin: 0;
  }
  .article-main :global(.theorem-preview-body) {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
    margin: 0.45rem 0 0;
  }
  .article-main :global(.theorem-preview-body > *) {
    margin-block: 0.55rem;
  }
  .article-main :global(.theorem-preview-body > :first-child) {
    margin-top: 0;
  }
  .article-main :global(.theorem-preview-body > :last-child) {
    margin-bottom: 0;
  }
  .article-main :global(.theorem-preview-body .katex-display),
  .article-main :global(.theorem-preview-body mjx-container[display="true"]) {
    box-sizing: border-box;
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.15rem;
    width: 100%;
  }
  .article-main :global(.theorem-preview-body mjx-container),
  .article-main :global(.theorem-preview-body .katex) {
    max-width: 100%;
  }
  .article-main :global(.theorem-preview-trigger:focus-visible) {
    border-radius: 0.2rem;
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .proof-toggle:hover { background: var(--accent-hover); }
  .proof-toggle:focus-visible { outline-offset: 3px; }
  .article-body.math-article :global(.katex-display),
